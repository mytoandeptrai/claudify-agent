{
  "name": "claudify-agent",
  "version": "1.0.14",
  "description": "Enterprise-grade workflow & context optimization framework for Claude Code, Claude Desktop, and AI coding agents.",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/mytoandeptrai/claudify-agent.git"
  },
  "type": "module",
  "main": "bin/cli.js",
  "bin": {
    "claudify-agent": "bin/cli.js",
    "claudify": "bin/cli.js"
  },
  "files": [
    "CLAUDE.md",
    ".claude",
    "bin",
    "templates",
    "README.md",
    "package.json"
  ],
  "scripts": {
    "lint": "eslint . --format=stylish",
    "lint:fix": "eslint . --fix",
    "typecheck": "tsc --noEmit",
    "validate": "node .claude/scripts/auto-validate.js",
    "security": "node .claude/scripts/security-scan.js"
  },
  "keywords": [
    "claude",
    "claude-code",
    "anthropic",
    "ai-agent",
    "mcp",
    "developer-tools",
    "token-optimization",
    "context-management",
    "golang",
    "nestjs",
    "solidity"
  ],
  "author": "mytoandeptrai <mytoandn@gmail.com>",
  "license": "MIT",
  "engines": {
    "node": ">=20.0.0"
  },
  "publishConfig": {
    "access": "public"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^26.6.6",
    "eslint": "^10.14.0",
    "globals": "^17.14.0",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.72.1"
  }
}
