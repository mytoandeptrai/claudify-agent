{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Edit|Write|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "command": "npx -y tsx \"$CLAUDE_PROJECT_DIR/.claude/hooks/auto-lint-fix.ts\"",
            "timeout": 90
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "npx -y tsx \"$CLAUDE_PROJECT_DIR/.claude/hooks/auto-validate.ts\"",
            "timeout": 300
          },
          {
            "type": "command",
            "command": "npx -y tsx \"$CLAUDE_PROJECT_DIR/.claude/hooks/auto-security-review.ts\"",
            "timeout": 60
          },
          {
            "type": "command",
            "command": "npx -y tsx \"$CLAUDE_PROJECT_DIR/.claude/hooks/plan-quality-tracker.ts\"",
            "timeout": 60
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "matcher": "startup",
        "hooks": [
          {
            "type": "command",
            "command": "npx -y tsx \"$CLAUDE_PROJECT_DIR/.claude/hooks/auto-learning-review.ts\"",
            "timeout": 60
          }
        ]
      }
    ]
  }
}
